<?xml version="1.0"?>
<!-- Exposes ClickHouse internal metrics in Prometheus format on :9363/metrics. -->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
