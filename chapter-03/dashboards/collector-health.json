{
  "annotations": {
    "list": []
  },
  "description": "OpenTelemetry Collector health dashboard for Chapter 3",
  "editable": true,
  "panels": [
    {
      "title": "Queue Depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "otelcol_exporter_queue_size",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2500 },
              { "color": "red", "value": 4000 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "title": "Export Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(otelcol_exporter_send_latency_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(otelcol_exporter_send_latency_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(otelcol_exporter_send_latency_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "title": "Drop Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(otelcol_processor_dropped_spans[5m])",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "title": "Retry Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(otelcol_exporter_send_failed_spans[5m])",
          "legendFormat": "{{pod}} - failed"
        },
        {
          "expr": "rate(otelcol_exporter_sent_spans[5m])",
          "legendFormat": "{{pod}} - success"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "title": "Memory Usage",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "process_runtime_total_alloc_bytes",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300000000 },
              { "color": "red", "value": 400000000 }
            ]
          }
        }
      }
    },
    {
      "title": "Spans Received vs Exported",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "rate(otelcol_receiver_accepted_spans[5m])",
          "legendFormat": "received"
        },
        {
          "expr": "rate(otelcol_exporter_sent_spans[5m])",
          "legendFormat": "exported"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["opentelemetry", "collector", "chapter-3"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "OTel Collector Health - Chapter 3",
  "uid": "ch3-collector-health"
}
